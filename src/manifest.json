{
  "manifest_version": 3,
  "name": "ChatGPT Explorer",
  "version": "0.4.0",
  "description": "A lightweight hierarchical explorer for ChatGPT conversations.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ChatGPT Explorer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
